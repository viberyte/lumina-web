hasDoodle\":false,\"gap\":\"40\",\"align\":\"flexStart\",\"padding\":{\"paddingTopMobile\":40,\"paddingBottomMobile\":40,\"paddingTopTablet\":96,\"paddingBottomTablet\":96,\"paddingTopDesktop\":108,\"paddingBottomDesktop\":108}},\"isRSC\":null},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"layerName\":\"Heading Component\",\"id\":\"builder-550a8cd915684a5980fa7e3295745148\",\"component\":{\"name\":\"Heading Component\",\"options\":{},\"isRSC\":null},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-607da59824ce40b0ba91d941b9e3f7e3\",\"component\":{\"name\":\"Heading\",\"options\":{\"highlight\":\"inherit\",\"type\":\"h2\",\"size\":{\"fontType\":\"display\",\"fontSize\":\"lg\",\"tabletFontType\":\"display\",\"tabletFontSize\":\"md\",\"mobileFontType\":\"display\",\"mobileFontSize\":\"sm\"},\"color\":{\"color\":\"lake\",\"temperature\":\"700\"},\"heading\":\"Featured Content\"},\"isRSC\":null}}]},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-43ca7b6612a0410e9433f57ab33ebb86\",\"component\":{\"name\":\"Deck\",\"options\":{\"enableDesktopModeOnly\":false},\"isRSC\":null},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-422725d8cc904e41829303333ab75ad0\",\"component\":{\"name\":\"Resource Card\",\"options\":{\"postType\":\"blog-detail\",\"post\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"b0e3e67be90f473cb53d1306a53ed593\",\"model\":\"blog-detail\",\"value\":{\"folders\":[],\"createdDate\":1744664438355,\"id\":\"b0e3e67be90f473cb53d1306a53ed593\",\"name\":\"The 2025 U.S. Restaurant Trends That Surprised Us\",\"modelId\":\"030e74ca80f348c9a802cab431d1da54\",\"published\":\"published\",\"meta\":{\"winningTest\":null,\"hasLinks\":false,\"kind\":\"page\",\"lastPreviewUrl\":\"https://sevenrooms.com/blog/api?secret=cerberus\u0026builder.space=acabda4a1104467f93cbad15a924c9a3\u0026builder.user.permissions=read%2Ccreate%2Cpublish%2CeditLayouts%2CeditContentPriority\u0026builder.user.role.name=Editor\u0026builder.user.role.id=editor\u0026builder.cachebust=true\u0026builder.preview=blog-detail\u0026builder.noCache=true\u0026builder.allowTextEdit=true\u0026__builder_editing__=true\u0026builder.overrides.blog-detail=b0e3e67be90f473cb53d1306a53ed593\u0026builder.overrides.b0e3e67be90f473cb53d1306a53ed593=b0e3e67be90f473cb53d1306a53ed593\u0026builder.options.includeRefs=true\u0026builder.options.enrich=true\",\"componentsUsed\":{\"Pro Tip\":2,\"Rich Text\":6,\"Quote\":1,\"Content Editor\":1,\"Form Detail\":1},\"originalContentId\":\"99179c68a59f47f797417a315daac7fc\"},\"query\":[{\"@type\":\"@builder.io/core:Query\",\"property\":\"urlPath\",\"operator\":\"is\",\"value\":\"/blog/surprising-us-restaurant-trends/\"}],\"data\":{\"readTime\":5,\"publishedDate\":1744687500000,\"seo\":{\"openGraph\":{\"ogImage\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F96e323c8f9f04363bb73309395e00bac\",\"ogTitle\":\"The 2025 U.S. Restaurant Trends That Surprised Us\",\"ogDescription\":\"From diversifying revenue streams and AI to high-end touches at every turn, these are the trends that shape what diners want in 2025 (and what it means for operators).\"},\"seoTitle\":\"The 2025 U.S. Restaurant Trends That Surprised Us\",\"twitter\":{\"twitterImage\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F392e39f62534480ca8e980a68ffc4830\",\"twitterTitle\":\"The 2025 U.S. Restaurant Trends That Surprised Us\",\"twitterDescription\":\"From diversifying revenue streams and AI to high-end touches at every turn, these are the trends that shape what diners want in 2025 (and what it means for operators).\"},\"seoDescription\":\"From diversifying revenue streams and AI to high-end touches at every turn, these are the trends that shape what diners want in 2025 (and what it means for operators).\",\"keywords\":{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your homepage is the digital front door of your restaurant. You should include eye-catching images of the food and guest experience, a link to your online menu, phone number, address, hours and location and a prominent placement of your reservation and online ordering widget to encourage action.\"},\"name\":\"What should be on the homepage of a restaurant website?\"},{\"name\":\"How do I make a good restaurant website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A great restaurant website is part of the customer experience — visitors should learn exactly what they can expect during an on-site visit just by going online. When designing it, be sure to include all the information your customers could want to know about your venue and make it easily accessible. This includes practical information, like location, contact info, social media links, hours and location, photos of food and ambiance, menus, about pages and an easy way to book reservations or online orders.\"},\"@type\":\"Question\"},{\"acceptedAnswer\":{\"text\":\"Two additional features to consider are accessibility features to ensure your site is accessible to all by following the Web Content Accessibility Guidelines (WCAG). This includes elements such as descriptive alt text, keyboard navigation, and high-contrast color schemes. Additionally, with internet traffic skewing heavily toward mobile, it’s important to keep your website mobile-friendly. A professional website designer or optimized design template should help ensure your pages are readable by smartphone or tablet.\",\"@type\":\"Answer\"},\"@type\":\"Question\",\"name\":\"What other features should I consider for a restaurant website?\"}]},\"noIndex\":false,\"noFollow\":false},\"url\":\"/blog/surprising-us-restaurant-trends/\",\"category\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"395276a7ffca4ff2a509a6c4e4e89f65\",\"model\":\"blog-category\",\"value\":{\"lastUpdatedBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"folders\":[],\"data\":{\"color\":\"green\",\"title\":\"Blog\"},\"modelId\":\"6ffff4c057094ef091ec757af842a496\",\"query\":[],\"published\":\"published\",\"firstPublished\":1707161916187,\"testRatio\":1,\"lastUpdated\":1707161916191,\"createdDate\":1707161899236,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"meta\":{\"kind\":\"data\",\"lastPreviewUrl\":\"\"},\"variations\":{},\"name\":\"Blog Category - Blog\",\"id\":\"395276a7ffca4ff2a509a6c4e4e89f65\",\"rev\":\"8hqxt0yowf\"}},\"categoryTwo\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"5b99bf694e274770b2617e1ad897bdbc\",\"model\":\"blog-category\",\"value\":{\"lastUpdatedBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"folders\":[],\"data\":{\"color\":\"saltWater\",\"title\":\"Marketing \u0026 Promotions\"},\"modelId\":\"6ffff4c057094ef091ec757af842a496\",\"query\":[],\"published\":\"published\",\"firstPublished\":1701723432444,\"testRatio\":1,\"lastUpdated\":1701723550842,\"createdDate\":1701723519391,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"meta\":{\"lastPreviewUrl\":\"\",\"kind\":\"data\",\"originalContentId\":\"c2d494749ab141328884e20a1a1f0eb3\",\"winningTest\":null},\"variations\":{},\"name\":\"Blog Category - Marketing \u0026 Promotions\",\"id\":\"5b99bf694e274770b2617e1ad897bdbc\",\"rev\":\"nemmf1h3kxg\"}},\"featuredImage\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fbc26c5fef1c24ae8afda5838f95e8f65\",\"alt\":\"Restaurant AI\"},\"description\":\"From diversifying revenue streams and AI to high-end touches at every turn, these are the trends that shape what diners want in 2025 (and what it means for operators).\",\"title\":\"The 2025 U.S. Restaurant Trends That Surprised Us\",\"blocks\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-b730bfbdd5564c6fa0bac246d94c46b4\",\"meta\":{\"previousId\":\"builder-42f2ced4dfeb4c95a43463c8d503f7e8\"},\"component\":{\"name\":\"Content Editor\",\"options\":{\"enableToc\":true,\"tocHeadline\":\"In this article\",\"enableSocialShare\":true,\"socialsHeadline\":\"Share this Post\"}},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-744792eb1daa4f71aef9eb68d843126a\",\"meta\":{\"previousId\":\"builder-6120f5bcedba4aea8f1e450575df08b7\"},\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$27\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-f32617c18ed64436933fe6279899c88a\",\"meta\":{\"previousId\":\"builder-f34d3bf5b0b448069adbaa83b0dbe0ac\"},\"component\":{\"name\":\"Pro Tip\",\"options\":{\"heading\":\"FYI\",\"content\":\"\u003cp\u003eDarwin Brasserie gave diners the option to upgrade to window seats during the reservation process and \u003ca href=\\\"https://sevenrooms.com/tools-resources/success-stories/darwin-brasserie-window-seats/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eincreased digital sales by 626%\u003c/a\u003e in just two months.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-2e47b79f3bb844a8909893b66059d22e\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F5e696db3dd68449d9f31060afbc3987e?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.666,\"lockAspectRatio\":false,\"height\":1065,\"width\":1600,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-115bab053f1245b5afa019ddfe8d4e73\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$28\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-7abd95cabca846aa9b33cc2253c27306\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$29\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-13144fb35472435b8fa65276eef4ab9e\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fb37d93c978a54b43b6445079837e3b9f?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":1.141,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":969,\"width\":849}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-29fc7daa09cd4dfa8fdf0e489c18618d\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$2a\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-e856e0796d794f569ed0c39ff47d785a\",\"component\":{\"name\":\"Quote\",\"options\":{\"quote\":\"\\\"We never want to send email and text on the same day...we do an email campaign and then the text message campaign goes out a few days later. Where we see the biggest spike [with text marketing] is when we roll out the urgency messaging. It's the FOMO. That's how we get the bulk of our covers.\\\" \\n- Henry Kaminski, Founder of Brand to Table and former CMO at Fabio Viviani Hospitality\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-567e138d658845039dc0d7e4d344f619\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$2b\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-298668932ce84410a70e3c7392c38bf8\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$2c\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-bd228820059f4842addd07d96f1deca1\",\"component\":{\"name\":\"Pro Tip\",\"options\":{\"heading\":\"\",\"content\":\"\u003cp\u003eDownload the full 2025 \u003ca href=\\\"https://sevenrooms.com/research/2025-US-restaurant-trends/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eU.S. Restaurant Industry Trends Report\u003c/a\u003e for even more restaurant business insights and takeaways. Or if you’re ready to make your hospitality SuperHuman, book a \u003ca href=\\\"https://sevenrooms.com/request-a-demo/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eSevenRooms demo today\u003c/a\u003e.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-fd1bdeccccd94598bc544084dd74a547\",\"meta\":{\"previousId\":\"builder-0b57b2b65728438eb4a3994f57129352\"},\"component\":{\"name\":\"Form Detail\",\"options\":{\"formLabelColor\":\"gray-700\",\"submitButtonColor\":\"gray-900\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}}]},{\"id\":\"builder-pixel-yumxnt55c4q\",\"@type\":\"@builder.io/sdk:Element\",\"tagName\":\"img\",\"properties\":{\"src\":\"https://cdn.builder.io/api/v1/pixel?apiKey=acabda4a1104467f93cbad15a924c9a3\",\"aria-hidden\":\"true\",\"alt\":\"\",\"role\":\"presentation\",\"width\":\"0\",\"height\":\"0\"},\"responsiveStyles\":{\"large\":{\"height\":\"0\",\"width\":\"0\",\"display\":\"block\",\"opacity\":\"0\",\"overflow\":\"hidden\",\"pointerEvents\":\"none\"}}}],\"state\":{\"deviceSize\":\"large\",\"location\":{\"pathname\":\"/\",\"path\":[\"\"],\"query\":{}}}},\"variations\":{},\"startDate\":1744896840000,\"lastUpdated\":1744896788382,\"firstPublished\":1744894764675,\"previewUrl\":\"https://sevenrooms.com/blog/api?secret=cerberus\",\"testRatio\":1,\"screenshot\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F2c6afba644c041fdbacc2d739ec55da7\",\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"lastUpdatedBy\":\"l2wDSYnhURfP02lm0DcgdQ5yhnu1\",\"rev\":\"5pml03b5lrb\"}}},\"isRSC\":null}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-0e4d14daa39741df879137cbe2de2703\",\"meta\":{\"previousId\":\"builder-422725d8cc904e41829303333ab75ad0\"},\"component\":{\"name\":\"Resource Card\",\"options\":{\"postType\":\"blog-detail\",\"post\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"99179c68a59f47f797417a315daac7fc\",\"model\":\"blog-detail\",\"value\":{\"folders\":[],\"createdDate\":1733758000489,\"id\":\"99179c68a59f47f797417a315daac7fc\",\"name\":\"9 Genius Ways Restaurants Are Using AI\",\"modelId\":\"030e74ca80f348c9a802cab431d1da54\",\"published\":\"published\",\"meta\":{\"lastPreviewUrl\":\"https://sevenrooms.com/blog/restaurant-AI/?builder.space=acabda4a1104467f93cbad15a924c9a3\u0026builder.user.permissions=read%2Ccreate%2Cpublish%2CeditLayouts%2CeditContentPriority\u0026builder.user.role.name=Editor\u0026builder.user.role.id=editor\u0026builder.cachebust=true\u0026builder.preview=blog-detail\u0026builder.noCache=true\u0026builder.allowTextEdit=true\u0026__builder_editing__=true\u0026builder.overrides.blog-detail=99179c68a59f47f797417a315daac7fc\u0026builder.overrides.99179c68a59f47f797417a315daac7fc=99179c68a59f47f797417a315daac7fc\u0026builder.options.includeRefs=true\u0026builder.options.enrich=true\",\"componentsUsed\":{\"Content Editor\":1,\"Rich Text\":9,\"Pro Tip\":2,\"Form Detail\":1},\"winningTest\":null,\"hasLinks\":false,\"kind\":\"page\",\"originalContentId\":\"e986ac88ebcb43f08f6992f269a70ba8\"},\"query\":[{\"@type\":\"@builder.io/core:Query\",\"property\":\"urlPath\",\"operator\":\"is\",\"value\":\"/blog/restaurant-AI/\"}],\"data\":{\"categoryTwo\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"5b99bf694e274770b2617e1ad897bdbc\",\"model\":\"blog-category\",\"value\":{\"lastUpdatedBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"folders\":[],\"data\":{\"color\":\"saltWater\",\"title\":\"Marketing \u0026 Promotions\"},\"modelId\":\"6ffff4c057094ef091ec757af842a496\",\"query\":[],\"published\":\"published\",\"firstPublished\":1701723432444,\"testRatio\":1,\"lastUpdated\":1701723550842,\"createdDate\":1701723519391,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"meta\":{\"lastPreviewUrl\":\"\",\"kind\":\"data\",\"originalContentId\":\"c2d494749ab141328884e20a1a1f0eb3\",\"winningTest\":null},\"variations\":{},\"name\":\"Blog Category - Marketing \u0026 Promotions\",\"id\":\"5b99bf694e274770b2617e1ad897bdbc\",\"rev\":\"nemmf1h3kxg\"}},\"publishedDate\":1744687500000,\"title\":\"9 Genius Ways Restaurants Are Using AI (and How You Can, Too)\",\"description\":\"Discover the top ways restaurateurs are using AI across operations, guest communications, data and marketing. \",\"url\":\"/blog/restaurant-AI/\",\"category\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"395276a7ffca4ff2a509a6c4e4e89f65\",\"model\":\"blog-category\",\"value\":{\"lastUpdatedBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"folders\":[],\"data\":{\"color\":\"green\",\"title\":\"Blog\"},\"modelId\":\"6ffff4c057094ef091ec757af842a496\",\"query\":[],\"published\":\"published\",\"firstPublished\":1707161916187,\"testRatio\":1,\"lastUpdated\":1707161916191,\"createdDate\":1707161899236,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"meta\":{\"kind\":\"data\",\"lastPreviewUrl\":\"\"},\"variations\":{},\"name\":\"Blog Category - Blog\",\"id\":\"395276a7ffca4ff2a509a6c4e4e89f65\",\"rev\":\"8hqxt0yowf\"}},\"readTime\":5,\"featuredImage\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F96e323c8f9f04363bb73309395e00bac\",\"alt\":\"Restaurant AI\"},\"seo\":{\"noIndex\":false,\"twitter\":{\"twitterTitle\":\"9 Genius Ways Restaurants Are Using AI (and How You Can, Too)\",\"twitterImage\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F96e323c8f9f04363bb73309395e00bac\",\"twitterDescription\":\"Discover the top ways restaurateurs are using AI across operations, guest communications, data and marketing. \"},\"seoDescription\":\"Discover the top ways restaurateurs are using AI across operations, guest communications, data and marketing. \",\"noFollow\":false,\"keywords\":{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"name\":\"What should be on the homepage of a restaurant website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your homepage is the digital front door of your restaurant. You should include eye-catching images of the food and guest experience, a link to your online menu, phone number, address, hours and location and a prominent placement of your reservation and online ordering widget to encourage action.\"},\"@type\":\"Question\"},{\"name\":\"How do I make a good restaurant website?\",\"acceptedAnswer\":{\"text\":\"A great restaurant website is part of the customer experience — visitors should learn exactly what they can expect during an on-site visit just by going online. When designing it, be sure to include all the information your customers could want to know about your venue and make it easily accessible. This includes practical information, like location, contact info, social media links, hours and location, photos of food and ambiance, menus, about pages and an easy way to book reservations or online orders.\",\"@type\":\"Answer\"},\"@type\":\"Question\"},{\"acceptedAnswer\":{\"text\":\"Two additional features to consider are accessibility features to ensure your site is accessible to all by following the Web Content Accessibility Guidelines (WCAG). This includes elements such as descriptive alt text, keyboard navigation, and high-contrast color schemes. Additionally, with internet traffic skewing heavily toward mobile, it’s important to keep your website mobile-friendly. A professional website designer or optimized design template should help ensure your pages are readable by smartphone or tablet.\",\"@type\":\"Answer\"},\"@type\":\"Question\",\"name\":\"What other features should I consider for a restaurant website?\"}]},\"openGraph\":{\"ogImage\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F96e323c8f9f04363bb73309395e00bac\",\"ogDescription\":\"Discover the top ways restaurateurs are using AI across operations, guest communications, data and marketing. \",\"ogTitle\":\"9 Genius Ways Restaurants Are Using AI (and How You Can, Too)\"},\"seoTitle\":\"9 Genius Ways Restaurants Are Using AI (and How You Can, Too)\"},\"blocks\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-42f2ced4dfeb4c95a43463c8d503f7e8\",\"meta\":{\"previousId\":\"builder-ae4132f70bba41e89c91235dc871dfc6\"},\"component\":{\"name\":\"Content Editor\",\"options\":{\"enableToc\":true,\"tocHeadline\":\"In this article\",\"enableSocialShare\":true,\"socialsHeadline\":\"Share this Post\"}},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-6120f5bcedba4aea8f1e450575df08b7\",\"meta\":{\"previousId\":\"builder-911245cb12e34d6fbe91d8202e5c3d0d\"},\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$2d\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-493a7d51cc524e67ab9634b8e4b19535\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003ch2\u003e1. Marketing and content creation\u003c/h2\u003e\u003cp\u003eAI is transforming content creation for restaurant marketers, helping write blog posts, generate social media captions, edit content and even create images.\u003c/p\u003e\u003cp\u003eOver half (51%) of respondents who use AI for marketing use it for video creation, 42% for generating images and 36% for copywriting.\u003c/p\u003e\u003cp\u003eAI tools use natural language processing and machine learning algorithms to understand context, tone and direction to create content and images that will resonate with your audience.\u0026nbsp;\u003c/p\u003e\u003cp\u003eIn fact, we asked AI to generate this image of “hands holding a delicious, juicy cheeseburger in a restaurant setting”. Here’s what we got in less than a minute:\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-58e85a307fc24c3f809ffa9a003f3f9a\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F77a0251cdbee4c86af76e2587d5c8dfe?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.68,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":244,\"width\":359}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-4a2276edb8c246bbb76e113e1910422a\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$2e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-f34d3bf5b0b448069adbaa83b0dbe0ac\",\"component\":{\"name\":\"Pro Tip\",\"options\":{\"heading\":\"Pro Tip\",\"content\":\"\u003cp\u003e\u003ca href=\\\"https://sevenrooms.com/tools-resources/playbooks-guides/chatgpt-restaurant-prompts/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eChatGPT can emulate writing styles\u003c/a\u003e. If you have published bylines, ask ChatGPT to write in your voice. Otherwise, choose a writer whose style fits your brand and include that direction in your prompt.”\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-8110837c7169477b908bfceb3baec694\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$2f\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-7f4d7dad090f47b1a1ac8abbec224236\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F51d3e1ae347f446593eb92f610e58e81?width=800\",\"backgroundSize\":\"contain\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.52,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":818,\"width\":1562,\"altText\":\"restaurant AI chatbot\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-49ad64909e234fc0bbe45236aa776e34\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003eBut chatbots don’t only have to be guest-facing.\u0026nbsp;\u003c/p\u003e\u003cp\u003eTake McDonald’s, for example. The fast food chain implemented a chatbot named “\u003ca href=\\\"https://www.bloomberg.com/news/articles/2023-12-06/mcdonald-s-mcd-getting-ai-chatbot-from-google-googl-for-restaurant-crew\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eAsk Pickles\u003c/a\u003e” to assist workers during their shifts. Pickles was trained on the company manuals, enabling it to provide answers to common shift conundrums like how to clean the chain’s ice cream machines.\u0026nbsp;\u003c/p\u003e\u003cp\u003eFaster answers and enhanced productivity? We’re lovin’ it!\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-f1146a01e0224207a348ecf0b292d6df\",\"component\":{\"name\":\"Pro Tip\",\"options\":{\"heading\":\"FYI\",\"content\":\"\u003cp\u003e\u003cstrong\u003e79% of diners are comfortable with restaurants using AI in the reservation process\u003c/strong\u003e, such as booking or modifying reservations via AI emails, texts or phone, but only \u003cstrong\u003e32% of operators globally\u003c/strong\u003e are using it in that way.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-2e5ae8bbda8042149915c93e9d790690\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$30\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-25e02d60156547e7ac0db75f0f21ada8\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003ch2\u003e7. Table management\u003c/h2\u003e\u003cp\u003eTable management can be a puzzle even the most experienced restauranteur needs help solving. Enter: artificial intelligence.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAI software can predict guest arrival patterns, optimize seating arrangements and reduce wait times. This improves your guests’ dining experience by ensuring they’re seated promptly and can also lead to more revenue.\u003c/p\u003e\u003cp\u003eSevenRooms’ \u003ca href=\\\"https://sevenrooms.com/platform/table-management/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eTable Management software\u003c/a\u003e uses an AI-driven seating algorithm that considers over 10,000 combinations every second. This reduces wait times and maximizes your floor plan, so you can serve more guests more often.\u0026nbsp;\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-732d3af848514f78aecdbeea84b6963d\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$31\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-a915ca2802da439d8e183f37de9cca3c\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$32\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-0b57b2b65728438eb4a3994f57129352\",\"meta\":{\"previousId\":\"builder-fbc264aa1c834cb688953a21c92ee00a\"},\"component\":{\"name\":\"Form Detail\",\"options\":{\"formLabelColor\":\"gray-700\",\"submitButtonColor\":\"gray-900\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}}]},{\"id\":\"builder-pixel-74phu2no0mk\",\"@type\":\"@builder.io/sdk:Element\",\"tagName\":\"img\",\"properties\":{\"src\":\"https://cdn.builder.io/api/v1/pixel?apiKey=acabda4a1104467f93cbad15a924c9a3\",\"aria-hidden\":\"true\",\"alt\":\"\",\"role\":\"presentation\",\"width\":\"0\",\"height\":\"0\"},\"responsiveStyles\":{\"large\":{\"height\":\"0\",\"width\":\"0\",\"display\":\"block\",\"opacity\":\"0\",\"overflow\":\"hidden\",\"pointerEvents\":\"none\"}}}],\"state\":{\"deviceSize\":\"large\",\"location\":{\"pathname\":\"/\",\"path\":[\"\"],\"query\":{}}}},\"variations\":{},\"startDate\":1733868000000,\"lastUpdated\":1744644241347,\"firstPublished\":1733779248072,\"previewUrl\":\"https://sevenrooms.com/blog/restaurant-AI/\",\"testRatio\":1,\"screenshot\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Ff2bc0a2fa47d4f83b323ee0647416a5e\",\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"lastUpdatedBy\":\"l2wDSYnhURfP02lm0DcgdQ5yhnu1\",\"rev\":\"i1ugkdfh11o\"}}},\"isRSC\":null}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-5f43fadf1cee45fb880750b8abb9381c\",\"meta\":{\"previousId\":\"builder-0e4d14daa39741df879137cbe2de2703\"},\"component\":{\"name\":\"Resource Card\",\"options\":{\"postType\":\"blog-detail\",\"post\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"a625913489e24f4f86934297ec0073df\",\"model\":\"blog-detail\",\"value\":{\"createdDate\":1747940491133,\"id\":\"a625913489e24f4f86934297ec0073df\",\"name\":\"How to Create Restaurant Merchandise Guests Will Obsess Over\",\"modelId\":\"030e74ca80f348c9a802cab431d1da54\",\"published\":\"published\",\"meta\":{\"originalContentId\":\"d6ce62f77537411bb92a88da0748ecc6\",\"lastPreviewUrl\":\"https://sevenrooms.com/blog/restaurant-merchandise/?builder.space=acabda4a1104467f93cbad15a924c9a3\u0026builder.user.permissions=read%2Ccreate%2Cpublish%2CeditLayouts%2CeditContentPriority%2CeditFolders\u0026builder.user.role.name=Editor\u0026builder.user.role.id=editor\u0026builder.cachebust=true\u0026builder.preview=blog-detail\u0026builder.noCache=true\u0026builder.allowTextEdit=true\u0026__builder_editing__=true\u0026builder.overrides.blog-detail=a625913489e24f4f86934297ec0073df\u0026builder.overrides.a625913489e24f4f86934297ec0073df=a625913489e24f4f86934297ec0073df\u0026builder.options.includeRefs=true\u0026builder.options.enrich=true\u0026builder.options.locale=Default\",\"winningTest\":null,\"componentsUsed\":{\"Content Editor\":1,\"Form Detail\":1,\"Rich Text\":12,\"Quote\":1},\"hasLinks\":false,\"kind\":\"page\"},\"query\":[{\"@type\":\"@builder.io/core:Query\",\"property\":\"urlPath\",\"operator\":\"is\",\"value\":\"/blog/restaurant-merchandise/\"}],\"data\":{\"featuredImage\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fd2cd51ee49f2413aa069a08139faddf8\",\"alt\":\"restaurant merchandise\"},\"seo\":{\"noFollow\":false,\"openGraph\":{\"ogImage\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fd2cd51ee49f2413aa069a08139faddf8\",\"ogTitle\":\"How to Create Restaurant Merchandise Guests Will Obsess Over\",\"ogDescription\":\"Get expert tips on how to design restaurant merchandise your guests will love, featuring successful restaurant examples from around the globe. \"},\"seoDescription\":\"Get expert tips on how to design restaurant merchandise your guests will love, featuring successful restaurant examples from around the globe. \",\"seoTitle\":\"How to Create Restaurant Merchandise Guests Will Obsess Over\",\"twitter\":{\"twitterImage\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fd2cd51ee49f2413aa069a08139faddf8\",\"twitterTitle\":\"How to Create Restaurant Merchandise Guests Will Obsess Over\",\"twitterDescription\":\"Get expert tips on how to design restaurant merchandise your guests will love, featuring successful restaurant examples from around the globe. \"},\"keywords\":{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"acceptedAnswer\":{\"text\":\"Your homepage is the digital front door of your restaurant. You should include eye-catching images of the food and guest experience, a link to your online menu, phone number, address, hours and location and a prominent placement of your reservation and online ordering widget to encourage action.\",\"@type\":\"Answer\"},\"name\":\"What should be on the homepage of a restaurant website?\",\"@type\":\"Question\"},{\"@type\":\"Question\",\"acceptedAnswer\":{\"text\":\"A great restaurant website is part of the customer experience — visitors should learn exactly what they can expect during an on-site visit just by going online. When designing it, be sure to include all the information your customers could want to know about your venue and make it easily accessible. This includes practical information, like location, contact info, social media links, hours and location, photos of food and ambiance, menus, about pages and an easy way to book reservations or online orders.\",\"@type\":\"Answer\"},\"name\":\"How do I make a good restaurant website?\"},{\"@type\":\"Question\",\"name\":\"What other features should I consider for a restaurant website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Two additional features to consider are accessibility features to ensure your site is accessible to all by following the Web Content Accessibility Guidelines (WCAG). This includes elements such as descriptive alt text, keyboard navigation, and high-contrast color schemes. Additionally, with internet traffic skewing heavily toward mobile, it’s important to keep your website mobile-friendly. A professional website designer or optimized design template should help ensure your pages are readable by smartphone or tablet.\"}}]},\"noIndex\":false},\"category\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"395276a7ffca4ff2a509a6c4e4e89f65\",\"model\":\"blog-category\",\"value\":{\"lastUpdatedBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"folders\":[],\"data\":{\"color\":\"green\",\"title\":\"Blog\"},\"modelId\":\"6ffff4c057094ef091ec757af842a496\",\"query\":[],\"published\":\"published\",\"firstPublished\":1707161916187,\"testRatio\":1,\"lastUpdated\":1707161916191,\"createdDate\":1707161899236,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"meta\":{\"kind\":\"data\",\"lastPreviewUrl\":\"\"},\"variations\":{},\"name\":\"Blog Category - Blog\",\"id\":\"395276a7ffca4ff2a509a6c4e4e89f65\",\"rev\":\"azk66k1v4hv\"}},\"description\":\"Get expert tips on how to design restaurant merchandise your guests will love, featuring successful restaurant examples from around the globe. \",\"url\":\"/blog/restaurant-merchandise/\",\"categoryTwo\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"5b99bf694e274770b2617e1ad897bdbc\",\"model\":\"blog-category\",\"value\":{\"lastUpdatedBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"folders\":[],\"data\":{\"color\":\"saltWater\",\"title\":\"Marketing \u0026 Promotions\"},\"modelId\":\"6ffff4c057094ef091ec757af842a496\",\"query\":[],\"published\":\"published\",\"firstPublished\":1701723432444,\"testRatio\":1,\"lastUpdated\":1701723550842,\"createdDate\":1701723519391,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"meta\":{\"lastPreviewUrl\":\"\",\"kind\":\"data\",\"originalContentId\":\"c2d494749ab141328884e20a1a1f0eb3\",\"winningTest\":null},\"variations\":{},\"name\":\"Blog Category - Marketing \u0026 Promotions\",\"id\":\"5b99bf694e274770b2617e1ad897bdbc\",\"rev\":\"uohhq865r5d\"}},\"readTime\":5,\"publishedDate\":1748439000000,\"title\":\"How to Create Restaurant Merchandise Guests Will Obsess Over\",\"blocks\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-94fe87fb9e6540c3a62c4f94ce8128cf\",\"meta\":{\"previousId\":\"builder-9316631bb35c4786a5971ca8bc52c98a\"},\"component\":{\"name\":\"Content Editor\",\"options\":{\"enableToc\":true,\"tocHeadline\":\"In this article\",\"enableSocialShare\":true,\"socialsHeadline\":\"Share this Post\"}},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-2320452155ec4587ab2c1f41a367f756\",\"meta\":{\"previousId\":\"builder-af635d949ca440dabbbf903b40b566f2\"},\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$33\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-bba27f257a0042f1974a8dec871e39c2\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$34\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-5d4d77bc782a48fca59e24ab2afae2fb\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003ch3\u003e1. Aprons worth showing off\u003c/h3\u003e\u003cp\u003eWhen designed well, aprons aren’t just for the kitchen—they’re statement pieces that signal craftsmanship and care.\u003c/p\u003e\u003cp\u003eAt \u003ca href=\\\"https://www.etchfood.co.uk/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eetch.\u003c/a\u003e, a refined modern British restaurant in the UK, Chef Steven Edwards sells the same 100% organic cotton aprons his team wears in the kitchen, made by Oliver Harvey.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-bfdbd91e6a8048b3ab23593c097c2a0e\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F5fbdc59973104a53bf17ab7e21e34edd?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.758,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":472,\"width\":623,\"altText\":\"restaurant merch apron\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-deec3c383eb0459a87251dbcde870121\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003e“For us, it felt like a natural extension of the experience at etch. It’s a great way for our guests to take home a souvenir and enhance the memory of their visit,” he said. “They’re the same aprons our chefs wear in the kitchen, known for their durability and design. It’s about offering our guests something authentic that represents what we stand for.\\\"\u003c/p\u003e\u003ch3\u003e2. T-shirts, hats and hoodies guests want to wear\u003c/h3\u003e\u003cp\u003eForget boxy tees with clip-art logos. Today’s t-shirts, hoodies, crewnecks and beanies are cut from high-quality cloth and built for fashion-minded diners.\u003c/p\u003e\u003cp\u003e“The style of hats has changed. The fabrics. The fit,” said Jacob. “If you want people to wear your merch, it has to feel like something they’d buy even without your name on it.”\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-f28940ec43214e44931dcf3703541d47\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F319e59a4c5664961873129d5481a40bd?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.933,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":672,\"width\":720}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-6dafff1942c54e63b8019b7ae60ea4d2\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003eAt \u003ca href=\\\"https://blabladubai.ae/beach-club/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eBla Bla Dubai\u003c/a\u003e—a high-energy beachfront dining and nightlife destination—the branded restaurant merchandise line reflects their cheeky personality. Guests can purchase bold gear like “Duck Off” t-shirts and hats that feel like trendy streetwear.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-70fc0454b7d74defa9a17d28b83d859c\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F8cbe0b2314054951a491dabbd56fa8ee?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.632,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":683,\"width\":1080}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-4ce2e31dc86b46e89da200ccffbb65d7\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003e“Our merchandise showcases our casual yet fun approach to life,” said guest relations manager Rheinardt Britz. “We ask ourselves one simple question: would I wear this to the shops?”\u003c/p\u003e\u003ch3\u003e3. Tote bags that tell a story\u003c/h3\u003e\u003cp\u003eA great tote is reusable, practical and makes a quiet design statement. It’s also a walking billboard—one guests will gladly carry if the look and quality are right.\u003c/p\u003e\u003cp\u003eAt \u003ca href=\\\"https://www.dishoom.com/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eDishoom\u003c/a\u003e, a beloved Indian restaurant group in London known for its richly detailed design and storytelling, every piece of merch is part of a broader brand narrative. Their \u003ca href=\\\"https://www.dishoom.com/store/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003erobust online store\u003c/a\u003e features stylish branded tote bags, along with a vast array of branded retail, books and homegoods that extend the multisensory dining experience.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-567ffed8bc4143b79289377c7d2ff935\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fe1862a9ef71a4ff3931d544c868b928f?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.472,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":528,\"width\":1119}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-4eddfda9208147279d3a1e839aff0530\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003ch3\u003e4. Cookbooks, meal kits and pantry goods that bring the experience home\u003c/h3\u003e\u003cp\u003eSome guests want to cook with you—literally. From jarred sauces and olive oils to full cookbooks and DIY kits, pantry-friendly merch helps recreate the restaurant magic at home.\u003c/p\u003e\u003cp\u003eAt Dishoom, meal kits let diners make signature dishes like their house bacon naan rolls from scratch. Their online store also features an award-winning cookbook that extends the brand’s rich storytelling and flavor into the home kitchen.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-c1043bf156894a1e839da5c2729c0882\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fcb1f172690a9434888fad2302d601510?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.558,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":445,\"width\":797}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-85114c9c551c420286899e3989993edd\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003eAt \u003ca href=\\\"https://www.aaliarestaurant.com/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eAalia in Sydney\u003c/a\u003e, guests can take home bottles of \u003cem\u003ePaul Farag x Rio Vista\u003c/em\u003e olive oil or a curated Medjool Date Box—both available as add-ons during the booking process.\u003c/p\u003e\u003cp\u003e“Our guests often connect with the flavours, ingredients and ethos behind our food, so offering something tangible felt like a natural progression,” said Natasha Hasna, Projects and Events Manager. “It’s a way to bring a bit of Aalia home.”\u003c/p\u003e\u003ch3\u003e5. Candles and ambiance to go\u003c/h3\u003e\u003cp\u003eGreat restaurant merch doesn't stop at the plate. Candles, hand wash, soaps and incense offer guests a way to relive the restaurant’s mood and memory at home.\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.quay.com.au/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eQuay\u003c/a\u003e, one of Sydney’s most iconic fine dining restaurants, created a signature candle that evokes the venue’s refined sensory experience.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-bb66f51a63e64139bb4ddec0a4adb986\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F5a4d1d7481fa4263a61307210210b935?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.642,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":505,\"width\":787}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-7ce4d216a0c44d51ad28016ec403b184\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003eAt Dishoom, guests can buy branded hand wash, body wash and signature incense sticks—each crafted to match the warm, spice-laden ambiance of their restaurants.\u003c/p\u003e\u003cp\u003e“Some restaurants are even turning signature cocktails into scented candles,” said Jacob. “A way to recreate the memory through smell, not just taste.”\u003c/p\u003e\u003ch3\u003e6. Useful glassware and functional keepsakes\u0026nbsp;\u003c/h3\u003e\u003cp\u003eFrom bottle openers to water bottles and tumblers, everyday utility items offer staying power—especially when they’re designed with care.\u003c/p\u003e\u003cp\u003eAt Bla Bla, functional meets fun with custom glassware designed with their signature JBR skyline— an unbreakable wine glass that’s as bold and playful as the venue itself—perfect for beachgoers and brand fans alike.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-9dd49b97e17041b1910c1d5e06870adf\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fd5c94a96bfde46fa82ce8f5eca9f54b0?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.647,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":419,\"width\":648}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-fd93630c9d464b639dd7384dc6c47b4c\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$35\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-889edfdc18d541b5bcc483fc2fb9a696\",\"component\":{\"name\":\"Image\",\"options\":{\"image\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fbf653f7c43864ae290b1b9f340f6641a?width=800\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\",\"lazy\":false,\"fitContent\":true,\"aspectRatio\":0.582,\"lockAspectRatio\":false,\"sizes\":\"(max-width: 638px) 90vw, (max-width: 998px) 58vw, 58vw\",\"height\":403,\"width\":693}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\",\"width\":\"100%\",\"minHeight\":\"20px\",\"minWidth\":\"20px\",\"overflow\":\"hidden\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-8e092a343a0b46c192895752520f42e5\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"$36\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-6285cb4857f047d7a9d8ee7b7d7b3d99\",\"component\":{\"name\":\"Quote\",\"options\":{\"quote\":\"“You’re sending walking billboards out into the world. It’s marketing you don’t have to pay for again.”\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-0327cbe0fde34d6b8f4ab1b357f4910d\",\"component\":{\"name\":\"Rich Text\",\"options\":{\"richText\":\"\u003cp\u003eAnd if you're looking to do it right from the start, consider partnering with a branding agency like \u003ca href=\\\"https://royagency.com/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"\u003eRoy\u003c/a\u003e. From concept to execution, his team can help turn your ideas into something guests actually want to wear, use and remember.\u003c/p\u003e\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-9342f787b991420d9910ab75e6e40ce4\",\"meta\":{\"previousId\":\"builder-cafb26a51db24c51a08329e4c76a6e9d\"},\"component\":{\"name\":\"Form Detail\",\"options\":{\"formLabelColor\":\"gray-700\",\"submitButtonColor\":\"gray-900\"}},\"responsiveStyles\":{\"large\":{\"position\":\"relative\"}}}]},{\"id\":\"builder-pixel-29vd808m9y2\",\"@type\":\"@builder.io/sdk:Element\",\"t