3%2Fa61b0037783b49f881f9ed010d25b74f\",\"role\":\"Marketing Director\",\"fullName\":\"James Smith\",\"email\":\"bianca@sevenrooms.com\",\"company\":\"Sevenrooms\"},\"variations\":{},\"lastUpdated\":1731976709018,\"firstPublished\":1701724744963,\"testRatio\":1,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"lastUpdatedBy\":\"pvLWf0giDRXSo9welzgfLqYza8i1\",\"rev\":\"wt5kk8ebhvd\"}},\"cardBackgroundImage\":{\"width\":300,\"height\":200,\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F575a153d15f74569b32f4fe7b07baf84\"},\"companyLogo\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F4930fed127614ad0a19dd0dd9760baa7\"}},\"heading\":\"\\\"When we first got SevenRooms, it was for reservations, now it powers upgrades, marketing, feedback, guest recovery \u0026 ticketed events. Our events bring in 200-300 guests, SevenRooms lets us capture every email \u0026 phone number.\\\"\",\"description\":\"Stephen Maly, Director of Guest Relations \u0026 Hospitality, IGC Hospitality\",\"cardBackgroundImage\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F52fe648ed4ca45918ef6d70e6f808c63\"}},{\"card\":{\"variant\":\"background-image\",\"quote\":\"\",\"author\":{\"@type\":\"@builder.io/core:Reference\",\"id\":\"34808c8f23bf46fdab9443f6a446a4f8\",\"model\":\"entity-author\",\"value\":{\"query\":[],\"folders\":[],\"createdDate\":1701724644783,\"id\":\"34808c8f23bf46fdab9443f6a446a4f8\",\"name\":\"Dummy Blog Detail - Entity Author\",\"modelId\":\"9237580add93410d97cb4fbb29fd3849\",\"published\":\"published\",\"meta\":{\"lastPreviewUrl\":\"\",\"kind\":\"data\"},\"data\":{\"description\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum, ac aliquet odio mattis. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos.\",\"headshot\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Fa61b0037783b49f881f9ed010d25b74f\",\"role\":\"Marketing Director\",\"fullName\":\"James Smith\",\"email\":\"bianca@sevenrooms.com\",\"company\":\"Sevenrooms\"},\"variations\":{},\"lastUpdated\":1731976709018,\"firstPublished\":1701724744963,\"testRatio\":1,\"createdBy\":\"6GvakQAYwcPfcEbpsKxTUjHecF22\",\"lastUpdatedBy\":\"pvLWf0giDRXSo9welzgfLqYza8i1\",\"rev\":\"wt5kk8ebhvd\"}},\"cardBackgroundImage\":{\"width\":300,\"height\":200,\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2Ff35061e31e7e4d5aa08aa0277e2b0876\"},\"companyLogo\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F1c3ca9712a8e44469eb50df20db10700\"}},\"heading\":\"“SevenRooms isn't just a reservation platform, it's also a powerful marketing tool, and its main focus is to maximise a restaurant's potential. It systematically helps us cut steps in our day-to-day operations that are unnecessary and time-consuming.”\",\"description\":\"Federica D’Incecco, Reservations and Events Manager, Nobu London\",\"cardBackgroundImage\":{\"src\":\"https://cdn.builder.io/api/v1/image/assets%2Facabda4a1104467f93cbad15a924c9a3%2F7aa01a4539e3415d9934e765cca0ee78\"}}]},\"isRSC\":null},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-5950f32a0a324b708e94a18ac05c7d05\",\"meta\":{\"previousId\":\"builder-141e839dad3f44e4a8d586f7f30a8740\"},\"component\":{\"name\":\"Metrics Content Editor\",\"options\":{},\"isRSC\":null},\"children\":[{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-8470a1db41cd4e0fb5a3fccc9fed55e3\",\"meta\":{\"previousId\":\"builder-b2ba4bdf305348238b63e62b36d8eee2\"},\"component\":{\"name\":\"Statistic\",\"options\":{\"stat\":\"$$2M\",\"description\":\"REVENUE GENERATED\",\"color\":\"Light Lake\",\"isCard\":false,\"alignment\":\"left\"},\"isRSC\":null}},{\"@type\":\"@builder.io/sdk:Element\",\"@version\":2,\"id\":\"builder-0d820b1787844e59