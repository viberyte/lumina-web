// ============================================
// TYPES
// ============================================
export interface Venue {
  id: number;
  name: string;
  category: string;
  neighborhood?: string;
  acoustic_band?: number;
  friction_score?: string;
  gatekeeper_status?: number;
  conversation_level?: number;
  photo_op_priority?: number;
  latitude?: number;
  longitude?: number;
  rating?: number;
  peak_friction_hour?: number;
  dwell_time_avg?: number;
  last_call_vibe?: boolean;
  momentum_risk_score?: number;
  image_url?: string;
  [key: string]: any;
}

export interface ArcVenue extends Venue {
  stop: number;
  role: 'safe' | 'elevated' | 'wildcard';
  effectiveFriction?: number;
  ai_reasoning?: string;
}

export interface ValidationResult {
  valid: boolean;
  code: string;
  message: string;
  venue?: Venue;
  stopIndex?: number;
}

export interface ArcValidation {
  valid: boolean;
  violations: ValidationResult[];
  score: number;
  dominantViolation?: string;
}

export type PersonaType = 'curator' | 'minimalist' | 'intellectual' | 'socialite' | 'insider' | 'wildcard' | 'default';

export interface RefereeContext {
  persona: PersonaType;
  occasion: string;
  hour: number;
  dayOfWeek: number;
  city: string;
  intentCuisine?: string;  // NEW: Lock referee to user's cuisine intent
}

