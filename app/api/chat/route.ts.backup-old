import { NextResponse } from 'next/server';
import OpenAI from 'openai';
import Database from 'better-sqlite3';

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

const FINE_TUNED_MODEL = 'ft:gpt-4o-mini-2024-07-18:viberyte:lumina-nightlife-v1:Cl4g83K2';

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
  'Access-Control-Allow-Headers': 'Content-Type, Authorization',
};

export async function OPTIONS() {
  return NextResponse.json({}, { headers: corsHeaders });
}

// Button options for each question
const BUTTONS = {
  persona: ["👥 Solo", "👫 Date Night", "🎉 Friends", "🎂 Birthday", "💼 Business"],
  primaryChoice: ["🍽️ Dinner", "🍸 Drinks/Lounge", "🎵 Events", "🥂 Brunch"],
  time: ["🌆 Evening (7-9pm)", "🌙 Late Night (10pm+)", "☀️ Brunch/Lunch"],
  energyLevel: ["😌 Chill & Cozy", "✨ Good Vibes", "🔥 High Energy"],
};

const SYSTEM_PROMPT = `You are Lumina, a warm nightlife concierge.

Extract context and decide if ready to plan:
{
  "action": "conversational" | "deliver_multi_stop",
  "response": "your message",
  "extractedContext": {
    "persona": "solo" | "date_night" | "friends" | "birthday" | "business" | null,
    "primaryChoice": "dinner" | "lounge" | "events" | "brunch" | null,
    "time": "dinner" | "night" | "late" | "brunch" | null,
    "energyLevel": "chill" | "medium" | "high" | null,
    "groupSize": number | null
  }
}

Rules:
- Use "conversational" to gather context with questions
- Use "deliver_multi_stop" only when you have 3+ context pieces
- Always respond with valid JSON

Examples:

User: "plan my night"
{"action":"conversational","response":"Who are you going with?","extractedContext":{}}

User: "my girlfriend"  
{"action":"conversational","response":"What are you in the mood for?","extractedContext":{"persona":"date_night","groupSize":2}}

User: "dinner"
{"action":"conversational","response":"What time?","extractedContext":{"persona":"date_night","primaryChoice":"dinner","groupSize":2}}

User: "7pm, somewhere chill"
{"action":"deliver_multi_stop","response":"Perfect! Let me find you spots...","extractedContext":{"persona":"date_night","primaryChoice":"dinner","time":"dinner","energyLevel":"chill","groupSize":2}}`;

function findVenue(name: string) {
  try {
    const db = new Database('/opt/viberyte/lumina-web/data/lumina.db');
    const venue = db.prepare('SELECT id, name, category, vibe_tags, music_genres FROM venues WHERE LOWER(name) LIKE LOWER(?) LIMIT 1').get(`%${name}%`);
    db.close();
    return venue;
  } catch (e) {
    return null;
  }
}

export async function POST(request: Request) {
  try {
    const { messages, sessionContext } = await request.json();
    
    console.log('💬 Incoming:', messages?.length, 'messages');
    
    const completion = await openai.chat.completions.create({
      model: FINE_TUNED_MODEL,
      messages: [
        { role: 'system', content: SYSTEM_PROMPT },
        ...messages
      ],
      temperature: 0.7,
      max_tokens: 400,
      response_format: { type: "json_object" }
    });
    
    let response = JSON.parse(completion.choices[0].message.content || '{}');
    
    console.log('🤖 AI Response:', response);
    
    // Merge context
    const context = { ...sessionContext, ...response.extractedContext };
    
    // COUNT how much context we have
    let contextCount = 0;
    if (context.persona || context.groupSize) contextCount++;
    if (context.primaryChoice) contextCount++;
    if (context.time) contextCount++;
    if (context.energyLevel) contextCount++;
    
    console.log(`📊 Context count: ${contextCount}/4`);
    
    // ADD BUTTONS based on what's missing
    if (response.action === 'conversational') {
      if (!context.persona && !context.groupSize) {
        response.options = BUTTONS.persona;
      } else if (!context.primaryChoice) {
        response.options = BUTTONS.primaryChoice;
      } else if (!context.time) {
        response.options = BUTTONS.time;
      } else if (!context.energyLevel) {
        response.options = BUTTONS.energyLevel;
      } else {
        // Fallback
        response.options = BUTTONS.energyLevel;
      }
    }
    
    console.log('✅ Final response:', response);
    
    return NextResponse.json(response, { headers: corsHeaders });
    
  } catch (error) {
    console.error('❌ Error:', error);
    return NextResponse.json(
      { 
        action: 'conversational',
        response: "Who are you going with tonight?",
        options: BUTTONS.persona,
        extractedContext: {}
      },
      { status: 500, headers: corsHeaders }
    );
  }
}
