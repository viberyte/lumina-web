// AI FALLBACK
// ============================================
const LUMINA_SYSTEM_PROMPT = `You are Lumina, a nightlife concierge with confident, warm energy. Think: your coolest friend who always knows the spot.

PERSONALITY:
- Confident but not cocky
- Warm, not bubbly
- Millennial energy (25-38 vibe)
- Short, punchy responses
- Use "got you" not "certainly"
- Sparingly use 💜 (max once)
- NEVER say "certainly", "absolutely", "I'd be delighted", "wonderful"

RESPONSE FORMAT (valid JSON only):
{
  "response": "Your message",
  "questionType": "cuisine" | "persona" | "time" | "energyLevel" | null
}

RULES:
- If user says "dinner" → ask cuisine. questionType: "cuisine", response: "dinner - I got you! 💜 What kind of food?"
- If unclear what they want → ask primaryChoice. questionType: "primaryChoice"
- Keep it to 1-2 sentences max
- Never over-explain`;

async function getAIResponse(userMessage: string, sessionContext: any): Promise<{ response: string; questionType: string | null }> {
  try {
    const messages = [
      { role: 'system' as const, content: LUMINA_SYSTEM_PROMPT },
      ...(sessionContext?.history || []).slice(-4),
      { role: 'user' as const, content: userMessage }
    ];

    const completion = await openai.chat.completions.create({
      model: FINE_TUNED_MODEL,
      messages,
      temperature: 0.6,
      max_tokens: 150,
      response_format: { type: "json_object" }
    });
    
    const text = completion.choices[0].message.content || '{}';
    const parsed = JSON.parse(text);
    
    return {
      response: parsed.response || "What are you feeling tonight?",
      questionType: parsed.questionType || null
    };
  } catch (error) {
    console.error('AI error:', error);
    return {
      response: "What are you feeling tonight?",
      questionType: 'primaryChoice'
    };
  }
}

// ============================================
// RESPONSE GENERATION (Persona-aware, post-Referee)
// ============================================
function generateResponseText(intent: ResolvedIntent, refereeResult: any): string {
  const { persona } = intent;
  const { hiddenTiers, pivotMessage } = refereeResult;
  
  // Base responses by persona
  const personaResponses: Record<PersonaType, string> = {
    curator: `Curated this just for you – looks matter tonight...`,
    minimalist: `Kept it clean and low-key – here's your night...`,
    intellectual: `Good conversation starts here – your night awaits...`,
    socialite: `Energy's right tonight – here's how to play it...`,
    insider: `Off the beaten path – only the real ones know these...`,
    wildcard: `Let's see where the night takes you...`,
    default: `Here's a few ways to play the night...`,
  };
  
  let response = personaResponses[persona] || personaResponses.default;
  
  // Append pivot message if tiers were hidden
  if (pivotMessage && hiddenTiers.length > 0 && hiddenTiers.length < 3) {
    response = `${response}\n\n${pivotMessage}`;
  }
  
  return response;
}

