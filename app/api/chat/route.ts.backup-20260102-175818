// MAIN HANDLER
// ============================================
export async function POST(request: Request) {
  try {
    const body = await request.json();
    const { message, messages, city, sessionContext = {} } = body;
    
    const userMessage = message || (messages && messages[messages.length - 1]?.content);
    
    if (!userMessage) {
      return NextResponse.json({ error: 'No message provided' }, { status: 400, headers: corsHeaders });
    }
    
    console.log('💬 Message:', userMessage);
    console.log('📋 Context:', JSON.stringify(sessionContext));
    
    // ========== DELIVERY LOCK ==========
    if (sessionContext?.delivered === true) {
      return NextResponse.json({
        response: "Want to tweak this or explore something else?",
        options: ["Start Over", "Different Cuisine", "Add Drinks"],
        sessionContext
      }, { headers: corsHeaders });
    }
    
    // ========== INTENT RESOLUTION ==========
    const intent = resolveIntent(userMessage, sessionContext);
    console.log('🎯 Intent:', JSON.stringify(intent));
    
    // ========== FAST-PATH DELIVERY ==========
    if (intent.shouldDeliver && intent.confidence === 'high') {
      // Feature gate
      if (!MULTI_STOP_ENABLED) {
        return NextResponse.json({
          response: "Multi-stop planning is coming soon! For now, explore venues on the Home and Explore tabs.",
          options: QUESTION_OPTIONS.primaryChoice,
          sessionContext: { ...sessionContext, persona: intent.persona }
        }, { headers: corsHeaders });
      }
      console.log('⚡ Fast-path delivery | Persona:', intent.persona);
      
      // Step 1: Get raw candidates from DB
      const rawCandidates = getRawCandidates(
        { primaryChoice: intent.primaryChoice, cuisine: intent.cuisine },
        city || 'Manhattan'
      );
      
      if (rawCandidates) {
        // Step 2: Build Referee context
        const now = new Date();
        const refereeContext: RefereeContext = {
          persona: intent.persona,
          occasion: intent.occasion || 'default',
          hour: now.getHours(),
          dayOfWeek: now.getDay(),
          city: city || 'Manhattan'
        };
        
        console.log('🎭 Referee context:', JSON.stringify(refereeContext));
        
        // Step 3: Run Referee validation + repair
        const refereeResult = referee.refereeCheck(rawCandidates, refereeContext);
        
        console.log('✅ Referee result:', {
          safeValid: refereeResult.safe.valid,
          safeScore: refereeResult.safe.score,
          elevatedValid: refereeResult.elevated.valid,
          elevatedScore: refereeResult.elevated.score,
          wildcardValid: refereeResult.wildcard.valid,
          wildcardScore: refereeResult.wildcard.score,
          hiddenTiers: refereeResult.hiddenTiers,
          recommendedTier: refereeResult.recommendedTier
        });
        
        // Step 4: Build response with Referee-approved arcs only
        const validMultiStop: any = {
          anchorVenue: refereeResult.safe.arc?.[0] 
            ? { id: refereeResult.safe.arc[0].id, name: refereeResult.safe.arc[0].name }
            : null,
          anchorSource: 'lumina',
          safe: refereeResult.safe.valid ? refereeResult.safe.arc : [],
          elevated: refereeResult.elevated.valid ? refereeResult.elevated.arc : [],
          wildcard: refereeResult.wildcard.valid ? refereeResult.wildcard.arc : [],
        };
        
        // Check if we have at least one valid tier
        const hasValidTier = refereeResult.safe.valid || refereeResult.elevated.valid || refereeResult.wildcard.valid;
        
        // BYPASS: If Referee rejects all tiers, return raw candidates directly
        if (!hasValidTier && rawCandidates) {
          console.log('⚠️ Referee rejected all - bypassing with raw candidates');
          console.log('📦 Raw candidates safe:', rawCandidates.safe?.length, rawCandidates.safe?.map(v => v.name));
          const label = intent.cuisine || intent.primaryChoice || 'perfect';
          
          const formatVenue = (v: any) => ({
            venue: {
              id: v.id,
              name: v.name,
              neighborhood: v.neighborhood,
              cuisine: v.cuisine_primary || v.category,
              photo: (() => { try { if (v.google_photos) { const p = typeof v.google_photos === "string" ? JSON.parse(v.google_photos) : v.google_photos; if (p && p[0]) return "https://lumina.viberyte.com" + p[0]; } return v.professional_photo_url || v.image_url; } catch(e) { return v.professional_photo_url || v.image_url; } })(),
              rating: v.rating,
              price_tier: v.price_tier,
              address: v.address
            },
            reasoning: v.ai_reasoning || `Great ${label} spot`,
            travelTime: 'Nearby',
            confidence: 0.7
          });
          
          const bypassMultiStop = {
            anchorVenue: rawCandidates.safe[0] ? { id: rawCandidates.safe[0].id, name: rawCandidates.safe[0].name } : null,
            anchorSource: 'lumina',
            safe: rawCandidates.safe.map(formatVenue),
            elevated: rawCandidates.elevated.map(formatVenue),
            wildcard: rawCandidates.wildcard.map(formatVenue),
          };
          
          return NextResponse.json({
            response: `Here are some ${label} spots for tonight! 🎉`,
            multiStop: bypassMultiStop,
            planExplanation: `Your ${label} night awaits`,
            options: [],
            sessionContext: { ...sessionContext, primaryChoice: intent.primaryChoice, cuisine: intent.cuisine, persona: intent.persona, occasion: intent.occasion, delivered: true }
          }, { headers: corsHeaders });
        }
        
        if (hasValidTier) {
          const label = intent.cuisine || intent.primaryChoice || 'perfect';
          const responseText = generateResponseText(intent, refereeResult);
          
          return NextResponse.json({
            response: responseText,
            multiStop: validMultiStop,
            multiStopMeta: {
              recommendedTier: refereeResult.recommendedTier,
              confidence: intent.confidence,
              persona: intent.persona,
              scores: {
                safe: refereeResult.safe.score,
                elevated: refereeResult.elevated.score,
                wildcard: refereeResult.wildcard.score
              },
              hiddenTiers: refereeResult.hiddenTiers
            },
            planExplanation: `Your ${label} night awaits`,
            pivotMessage: refereeResult.pivotMessage,
            options: [],
            sessionContext: {
              ...sessionContext,
              primaryChoice: intent.primaryChoice,
              cuisine: intent.cuisine,
              persona: intent.persona,
              occasion: intent.occasion,
              delivered: true,
              history: [
                ...(sessionContext?.history || []),
                { role: 'user', content: userMessage },
                { role: 'assistant', content: responseText }
              ]
            }
          }, { headers: corsHeaders });
        }
      }
    }
    
    // ========== DINNER WITHOUT CUISINE → ASK ==========
    if (intent.primaryChoice === 'dinner' && !intent.cuisine) {
      return NextResponse.json({
        response: "dinner - I got you! 💜\n\nWhat kind of food?",
        options: QUESTION_OPTIONS.cuisine,
        sessionContext: {
          ...sessionContext,
          primaryChoice: 'dinner',
          persona: intent.persona,
          occasion: intent.occasion,
          history: [
            ...(sessionContext?.history || []),
            { role: 'user', content: userMessage },
            { role: 'assistant', content: "dinner - I got you! 💜 What kind of food?" }
          ]
        }
      }, { headers: corsHeaders });
    }
    
    // ========== AI FALLBACK ==========
    console.log('🤖 Falling back to AI');
    const aiResponse = await getAIResponse(userMessage, sessionContext);
    
    return NextResponse.json({
      response: aiResponse.response,
      options: aiResponse.questionType ? QUESTION_OPTIONS[aiResponse.questionType] || [] : [],
      sessionContext: {
        ...sessionContext,
        persona: intent.persona,
        occasion: intent.occasion,
        history: [
          ...(sessionContext?.history || []),
          { role: 'user', content: userMessage },
          { role: 'assistant', content: aiResponse.response }
        ]
      }
    }, { headers: corsHeaders });
    
  } catch (error: any) {
    console.error('❌ Error:', error);
    return NextResponse.json({
      response: "What are you feeling tonight?",
      options: QUESTION_OPTIONS.primaryChoice,
      sessionContext: {}
    }, { status: 500, headers: corsHeaders });
  }
}
