// ============================================
// PERSONA DETECTION
// ============================================
function detectPersona(message: string, sessionContext: any): { persona: PersonaType; confidence: 'high' | 'medium' | 'low' } {
  const m = message.toLowerCase();
  const contextPersona = sessionContext?.persona;
  
  if (m.includes('aesthetic') || m.includes('photo') || m.includes('instagram') || m.includes('fancy') || m.includes('impressive')) {
    return { persona: 'curator', confidence: 'high' };
  }
  if (m.includes('low-key') || m.includes('lowkey') || m.includes('simple') || m.includes('clean') || m.includes('quiet') || m.includes('chill')) {
    return { persona: 'minimalist', confidence: 'high' };
  }
  if (m.includes('conversation') || m.includes('talk') || m.includes('jazz') || m.includes('wine bar') || m.includes('intimate')) {
    return { persona: 'intellectual', confidence: 'high' };
  }
  if (m.includes('energy') || m.includes('buzzing') || m.includes('fun') || m.includes('vibe') || m.includes('scene')) {
    return { persona: 'socialite', confidence: 'high' };
  }
  if (m.includes('hidden') || m.includes('local') || m.includes('secret') || m.includes('speakeasy') || m.includes('underground')) {
    return { persona: 'insider', confidence: 'high' };
  }
  if (m.includes('surprise') || m.includes('anything') || m.includes('whatever') || m.includes('adventure')) {
    return { persona: 'wildcard', confidence: 'high' };
  }
  if (m.includes('date') || m.includes('romantic') || m.includes('impress')) {
    return { persona: 'minimalist', confidence: 'medium' };
  }
  if (m.includes('friends') || m.includes('group') || m.includes('birthday') || m.includes('celebration')) {
    return { persona: 'socialite', confidence: 'medium' };
  }
  
  return { persona: contextPersona || 'default', confidence: 'low' };
}

// ============================================
// INTENT RESOLUTION
// ============================================
interface ResolvedIntent {
  primaryChoice: 'dinner' | 'drinks' | 'events' | 'full_night' | null;
  cuisine: string | null;
  shouldDeliver: boolean;
  confidence: 'high' | 'medium' | 'low';
  persona: PersonaType;
  occasion: string | null;
}

function resolveIntent(message: string, sessionContext: any): ResolvedIntent {
  // Energy level selection = ready to deliver
  const energyLevels = ['high energy', 'chill & cozy', 'chill and cozy', 'good vibes', 'chill', 'relaxed', 'turn up'];
  const selectedEnergy = energyLevels.some(e => message.toLowerCase().includes(e));
  if (selectedEnergy && sessionContext?.primaryChoice) {
    const { persona } = detectPersona(message, sessionContext);
    return { primaryChoice: sessionContext.primaryChoice, cuisine: sessionContext.cuisine || null, shouldDeliver: true, confidence: 'high', persona, occasion: sessionContext?.occasion || null };
  }

  const m = message.toLowerCase().trim();
  const { persona } = detectPersona(message, sessionContext);
  
  let occasion: string | null = sessionContext?.occasion || null;
  if (m.includes('date')) occasion = 'date';
  if (m.includes('friends')) occasion = 'friends';
  if (m.includes('birthday')) occasion = 'birthday';
  if (m.includes('solo') || m.includes('alone')) occasion = 'solo';
  if (m.includes('business') || m.includes('client')) occasion = 'business';
  
  const foundCuisine = CUISINES.find(c => m.includes(c));
  if (foundCuisine) {
    return { primaryChoice: 'dinner', cuisine: foundCuisine, shouldDeliver: true, confidence: 'high', persona, occasion };
  }
  
  if (m.includes('drinks') || m.includes('bar') || m.includes('lounge') || m.includes('rooftop') || m.includes('cocktail')) {
    return { primaryChoice: 'drinks', cuisine: null, shouldDeliver: true, confidence: 'high', persona, occasion };
  }
  
  if (m.includes('dinner') || m.includes('eat') || m.includes('food') || m.includes('hungry')) {
    return { primaryChoice: 'dinner', cuisine: null, shouldDeliver: false, confidence: 'high', persona, occasion };
  }
  
  if (m.includes('event') || m.includes('party') || m.includes('club') || m.includes('afrobeats') || m.includes('concert')) {
    return { primaryChoice: 'events', cuisine: null, shouldDeliver: true, confidence: 'high', persona, occasion };
  }
  
  if (m.includes('plan my night') || m.includes('full night') || m.includes('whole night')) {
    return { primaryChoice: 'full_night', cuisine: null, shouldDeliver: false, confidence: 'medium', persona, occasion };
  }
  
  if (sessionContext?.primaryChoice === 'dinner' && !sessionContext?.cuisine) {
    const possibleCuisine = CUISINES.find(c => m.includes(c));
    if (possibleCuisine) {
      return { primaryChoice: 'dinner', cuisine: possibleCuisine, shouldDeliver: true, confidence: 'high', persona, occasion };
    }
  }
  
  return {
    primaryChoice: sessionContext?.primaryChoice || null,
    cuisine: sessionContext?.cuisine || null,
    shouldDeliver: false,
    confidence: 'low',
    persona,
    occasion
  };
}

// ============================================
// VENUE FETCHER (Raw candidates - Referee validates after)
// ============================================
function getRawCandidates(context: any, city: string): { safe: ArcVenue[]; elevated: ArcVenue[]; wildcard: ArcVenue[] } | null {
  let db: any = null;
  try {
    db = new Database('/opt/viberyte/lumina-web/data/lumina.db');
    
    const primaryChoice = context.primaryChoice || 'dinner';
    const cuisine = context.cuisine;
    
    let primaryCategory = 'restaurant';
    if (primaryChoice === 'dinner' || cuisine) primaryCategory = 'restaurant';
    else if (primaryChoice === 'drinks') primaryCategory = 'lounge';
    else if (primaryChoice === 'events') primaryCategory = 'club';
    
    let cuisineFilter = '';
    if (cuisine) {
      cuisineFilter = `AND (LOWER(cuisine_types) LIKE '%${cuisine.toLowerCase()}%' OR LOWER(cuisine_primary) LIKE '%${cuisine.toLowerCase()}%' OR LOWER(cuisine) LIKE '%${cuisine.toLowerCase()}%')`;
    }
    
    // SAFE candidates
    const safeQuery = `
      SELECT id, name, category, neighborhood, cuisine_types, cuisine_primary, vibe_tags, 
             rating, price_tier, image_url, professional_photo_url, google_photos, address, acoustic_band, friction_score,
             gatekeeper_status, conversation_level, photo_op_priority, latitude, longitude,
             peak_friction_hour, dwell_time_avg, last_call_vibe, momentum_risk_score
      FROM venues 
      WHERE category = '${primaryCategory}' ${cuisineFilter}
        AND city IN ('Manhattan', 'New York', 'Brooklyn', 'Queens')
        AND (image_url IS NOT NULL OR professional_photo_url IS NOT NULL)
        AND should_exclude = 0
      ORDER BY rating DESC, RANDOM()
      LIMIT 5
    `;
    console.log('🔍 Safe Query:', safeQuery);
    const safeRaw = db.prepare(safeQuery).all() as any[];
    console.log('🍣 Safe results:', safeRaw.map(v => v.name + ' - ' + v.cuisine_primary));
    
    if (safeRaw.length === 0) {
      db.close();
      return null;
    }
    
    const excludeIds = safeRaw.map(v => v.id);
    const excludePlaceholder = excludeIds.map(() => '?').join(',');
    
    // ELEVATED candidates
    const elevatedQuery = `
      SELECT id, name, category, neighborhood, vibe_tags, rating, price_tier, image_url, professional_photo_url, google_photos, 
             address, acoustic_band, friction_score, gatekeeper_status, conversation_level,
             photo_op_priority, latitude, longitude, peak_friction_hour, dwell_time_avg,
             last_call_vibe, momentum_risk_score
      FROM venues 
      WHERE category IN ('lounge', 'bar')
        AND city IN ('Manhattan', 'New York', 'Brooklyn', 'Queens')
        AND id NOT IN (${excludePlaceholder})
        AND (image_url IS NOT NULL OR professional_photo_url IS NOT NULL)
        AND should_exclude = 0
      ORDER BY rating DESC, RANDOM()
      LIMIT 4
    `;
    const elevatedRaw = db.prepare(elevatedQuery).all(...excludeIds) as any[];
    
    // WILDCARD candidates
    const wildcardQuery = `
      SELECT id, name, category, neighborhood, vibe_tags, rating, price_tier, image_url, professional_photo_url, google_photos,
             address, acoustic_band, friction_score, gatekeeper_status, conversation_level,
             photo_op_priority, latitude, longitude, peak_friction_hour, dwell_time_avg,
             last_call_vibe, momentum_risk_score
      FROM venues 
      WHERE category = 'club'
        AND city IN ('Manhattan', 'New York', 'Brooklyn', 'Queens')
        AND id NOT IN (${excludePlaceholder})
        AND (image_url IS NOT NULL OR professional_photo_url IS NOT NULL)
        AND should_exclude = 0
      ORDER BY RANDOM()
      LIMIT 4
    `;
    const wildcardRaw = db.prepare(wildcardQuery).all(...excludeIds) as any[];
    
    db.close();
    
    // Convert to ArcVenue format
    const safe: ArcVenue[] = safeRaw.slice(0, 3).map((v, i) => ({
      ...v,
      stop: i,
      role: 'safe' as const,
      ai_reasoning: i === 0 ? 'Top pick for your night' : `Great ${cuisine || 'spot'} in ${v.neighborhood || 'the area'}`
    }));
    
    const elevated: ArcVenue[] = elevatedRaw.slice(0, 2).map((v, i) => ({
      ...v,
      stop: i,
      role: 'elevated' as const,
      ai_reasoning: `Elevated second stop – ${v.category} vibes`
    }));
    
    const wildcard: ArcVenue[] = wildcardRaw.slice(0, 2).map((v, i) => ({
      ...v,
      stop: i,
      role: 'wildcard' as const,
      ai_reasoning: `Late night wildcard – if the night keeps going`
    }));
    
    return { safe, elevated, wildcard };
    
  } catch (error) {
    console.error('❌ Database error:', error);
    if (db) db.close();
    return null;
  }
}

