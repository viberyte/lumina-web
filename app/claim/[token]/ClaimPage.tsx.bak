'use client';

import { useState } from 'react';

interface Props {
  partner: any;
  events: any[];
  token: string;
}

export default function ClaimPage({ partner, events, token }: Props) {
  const [step, setStep] = useState(partner.isClaimed ? 'success' : 'preview');
  const [phone, setPhone] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const handleClaim = async () => {
    if (!phone || phone.length < 10) { setError('Please enter a valid phone number'); return; }
    setLoading(true);
    setError('');
    try {
      const res = await fetch('/api/partner/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, phone }),
      });
      const data = await res.json();
      if (res.ok) { setStep('success'); } else { setError(data.error || 'Something went wrong'); }
    } catch (err) {
      setError('Network error. Please try again.');
    } finally {
      setLoading(false);
    }
  };

  const hero = partner.gallery && partner.gallery.length > 0
    ? (partner.gallery[0].startsWith('/') ? 'https://lumina.viberyte.com' + partner.gallery[0] : partner.gallery[0])
    : null;

  if (step === 'success') {
    return (
      <div style={{ minHeight: '100vh', backgroundColor: '#09090b', color: '#fff', fontFamily: 'system-ui, sans-serif', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
        <div style={{ textAlign: 'center', padding: '40px 20px' }}>
          <div style={{ fontSize: 48, marginBottom: 16 }}>\u{1F389}</div>
          <h2 style={{ fontSize: 24, fontWeight: 800, margin: '0 0 8px' }}>{partner.isClaimed ? 'Already Claimed!' : 'Page Claimed!'}</h2>
          <p style={{ fontSize: 15, color: '#a1a1aa', margin: '0 0 24px' }}>Download Lumina to manage your events, bookings, and more.</p>
          <a href="https://apps.apple.com/app/lumina-nightlife/id6738979697" style={{ display: 'inline-block', padding: '14px 32px', borderRadius: 12, background: '#fff', color: '#000', fontSize: 16, fontWeight: 700, textDecoration: 'none' }}>Download Lumina</a>
        </div>
      </div>
    );
  }

  return (
    <div style={{ minHeight: '100vh', backgroundColor: '#09090b', color: '#fff', fontFamily: 'system-ui, sans-serif' }}>
      <div style={{ position: 'relative', height: 300, overflow: 'hidden' }}>
        {hero ? (
          <img src={hero} alt={partner.businessName} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
        ) : (
          <div style={{ width: '100%', height: '100%', background: 'linear-gradient(135deg, #7c3aed, #ec4899)' }} />
        )}
        <div style={{ position: 'absolute', inset: 0, background: 'linear-gradient(to top, #09090b 0%, transparent 60%)' }} />
        <div style={{ position: 'absolute', top: 20, left: 20 }}>
          <span style={{ fontSize: 14, fontWeight: 700, color: '#fff', letterSpacing: 2 }}>LUMINA</span>
        </div>
      </div>

      <div style={{ maxWidth: 480, margin: '0 auto', padding: '0 20px' }}>
        <div style={{ marginTop: -60, position: 'relative', zIndex: 10 }}>
          <h1 style={{ fontSize: 28, fontWeight: 800, margin: 0, lineHeight: 1.2 }}>{partner.businessName}</h1>
          {partner.venueAddress && (
            <p style={{ fontSize: 14, color: '#71717a', margin: '4px 0 0' }}>{partner.venueAddress}{partner.venueCity ? ', ' + partner.venueCity : ''}</p>
          )}
          {partner.instagram && (
            <a href={'https://instagram.com/' + partner.instagram} target="_blank" rel="noopener noreferrer" style={{ fontSize: 14, color: '#ec4899', textDecoration: 'none', display: 'inline-block', marginTop: 8 }}>@{partner.instagram}</a>
          )}
        </div>

        <div style={{ marginTop: 32, padding: 20, borderRadius: 16, backgroundColor: 'rgba(139,92,246,0.08)', border: '1px solid rgba(139,92,246,0.2)' }}>
          <h2 style={{ fontSize: 18, fontWeight: 700, margin: '0 0 16px', color: '#a78bfa' }}>Your page is live on Lumina</h2>
          <ul style={{ listStyle: 'none', padding: 0, margin: 0, display: 'flex', flexDirection: 'column', gap: 10 }}>
            <li style={{ fontSize: 14, color: '#d4d4d8' }}>Instagram photos auto-populate your page</li>
            <li style={{ fontSize: 14, color: '#d4d4d8' }}>Your reels show in Recent Vibes</li>
            <li style={{ fontSize: 14, color: '#d4d4d8' }}>Post and manage events directly</li>
            <li style={{ fontSize: 14, color: '#d4d4d8' }}>Accept bookings (tables, bottle service)</li>
            <li style={{ fontSize: 14, color: '#d4d4d8' }}>Analytics on views, taps, and saves</li>
            <li style={{ fontSize: 14, color: '#d4d4d8' }}>Shareable NightLink for every event</li>
          </ul>
        </div>

        {events.length > 0 && (
          <div style={{ marginTop: 32 }}>
            <h2 style={{ fontSize: 18, fontWeight: 700, margin: '0 0 16px' }}>Your Events</h2>
            {events.map((event: any) => (
              <div key={event.id} style={{ display: 'flex', gap: 12, padding: 12, borderRadius: 12, backgroundColor: 'rgba(255,255,255,0.04)', marginBottom: 8 }}>
                {event.image && (
                  <img src={event.image.startsWith('/') ? 'https://lumina.viberyte.com' + event.image : event.image} alt={event.title} style={{ width: 60, height: 60, borderRadius: 8, objectFit: 'cover' }} />
                )}
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 15, fontWeight: 600, color: '#fff' }}>{event.title}</div>
                  <div style={{ fontSize: 13, color: '#71717a', marginTop: 2 }}>{event.genre}{event.isRecurring ? ' - Weekly' : ''}</div>
                </div>
              </div>
            ))}
          </div>
        )}

        {step === 'preview' && (
          <div style={{ marginTop: 40, textAlign: 'center' }}>
            <button onClick={() => setStep('verify')} style={{ width: '100%', padding: 16, borderRadius: 14, border: 'none', background: 'linear-gradient(135deg, #7c3aed, #a855f7)', color: '#fff', fontSize: 17, fontWeight: 700, cursor: 'pointer' }}>Claim This Page</button>
            <p style={{ fontSize: 13, color: '#52525b', marginTop: 12 }}>Free to claim - Takes 30 seconds</p>
          </div>
        )}

        {step === 'verify' && (
          <div style={{ marginTop: 40 }}>
            <h2 style={{ fontSize: 20, fontWeight: 700, margin: '0 0 8px' }}>Verify ownership</h2>
            <p style={{ fontSize: 14, color: '#71717a', margin: '0 0 20px' }}>Enter the phone number associated with this venue.</p>
            <input type="tel" value={phone} onChange={(e) => setPhone(e.target.value)} placeholder="(555) 123-4567" style={{ width: '100%', padding: '14px 16px', borderRadius: 12, border: '1px solid rgba(255,255,255,0.1)', backgroundColor: 'rgba(255,255,255,0.05)', color: '#fff', fontSize: 16, outline: 'none', boxSizing: 'border-box' }} />
            {error && <p style={{ fontSize: 13, color: '#ef4444', marginTop: 8 }}>{error}</p>}
            <button onClick={handleClaim} disabled={loading} style={{ width: '100%', padding: 16, borderRadius: 14, border: 'none', background: loading ? '#3f3f46' : 'linear-gradient(135deg, #7c3aed, #a855f7)', color: '#fff', fontSize: 17, fontWeight: 700, cursor: loading ? 'default' : 'pointer', marginTop: 16 }}>{loading ? 'Verifying...' : 'Verify & Claim'}</button>
          </div>
        )}

        <div style={{ height: 80 }} />
      </div>
    </div>
  );
}
